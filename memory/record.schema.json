{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curated memory record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "namespace",
    "kind",
    "status",
    "statement",
    "source_ref",
    "source_date",
    "recorded_at",
    "valid_from",
    "valid_to",
    "confidence",
    "supersedes",
    "review_after",
    "expires_at",
    "sensitivity",
    "links"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "preference",
        "fact",
        "decision",
        "episode",
        "hypothesis",
        "lesson"
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "accepted",
        "superseded"
      ]
    },
    "confidence": {
      "enum": [
        "observed",
        "user-stated",
        "inferred"
      ]
    },
    "sensitivity": {
      "enum": [
        "synthetic",
        "public",
        "private"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_date": {
      "type": "string",
      "format": "date"
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "review_after": {
      "type": "string",
      "format": "date"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation",
          "target_id"
        ],
        "properties": {
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
