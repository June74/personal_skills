{
  "checks": [
    {
      "name": "lint",
      "argv": [
        "uv",
        "run",
        "--no-sync",
        "ruff",
        "check",
        "."
      ],
      "timeout_seconds": 120
    },
    {
      "name": "format",
      "argv": [
        "uv",
        "run",
        "--no-sync",
        "ruff",
        "format",
        "--check",
        "."
      ],
      "timeout_seconds": 120
    },
    {
      "name": "types",
      "argv": [
        "uv",
        "run",
        "--no-sync",
        "mypy",
        "src"
      ],
      "timeout_seconds": 120
    },
    {
      "name": "tests",
      "argv": [
        "uv",
        "run",
        "--no-sync",
        "pytest",
        "-q"
      ],
      "timeout_seconds": 300
    }
  ]
}
